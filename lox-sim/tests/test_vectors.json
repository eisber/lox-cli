    {
      "id": "tv09-threshold-hysteresis-rising-falling",
      "description": "AnalogThresholdTrigger: rises at On and falls at Off",
      "blocks": [
        {
          "type": "AnalogThresholdTrigger",
          "title": "Tank Level",
          "connectors": [
            "Input",
            "Q",
            "RisingEdge",
            "FallingEdge",
            "On",
            "Off"
          ],
          "params": {
            "On": 10.0,
            "Off": 8.0
          }
        }
      ],
      "wiring": [
        {
          "from": "input:0",
          "to": "Tank Level.Input"
        }
      ],
      "steps": [
        {
          "inputs": [
            7.0
          ],
          "ticks": 1,
          "expected": {
            "Tank Level.Q": 0.0,
            "Tank Level.RisingEdge": 0.0,
            "Tank Level.FallingEdge": 0.0
          }
        },
        {
          "inputs": [
            10.0
          ],
          "ticks": 1,
          "expected": {
            "Tank Level.Q": 1.0,
            "Tank Level.RisingEdge": 1.0,
            "Tank Level.FallingEdge": 0.0
          }
        },
        {
          "inputs": [
            9.0
          ],
          "ticks": 1,
          "expected": {
            "Tank Level.Q": 1.0,
            "Tank Level.RisingEdge": 0.0,
            "Tank Level.FallingEdge": 0.0
          }
        },
        {
          "inputs": [
            8.0
          ],
          "ticks": 1,
          "expected": {
            "Tank Level.Q": 0.0,
            "Tank Level.RisingEdge": 0.0,
            "Tank Level.FallingEdge": 1.0
          }
        }
      ]
    },
