{
  "vectors": [
    {
      "id": "tv01-and-both-high",
      "description": "And gate: both inputs high -> output high",
      "blocks": [
        {
          "type": "And",
          "title": "Test And",
          "connectors": [
            "I1",
            "I2",
            "Q"
          ]
        }
      ],
      "wiring": [
        {
          "from": "input:0",
          "to": "Test And.I1"
        },
        {
          "from": "input:1",
          "to": "Test And.I2"
        }
      ],
      "steps": [
        {
          "inputs": [
            0.0,
            0.0
          ],
          "ticks": 1,
          "expected": {
            "Test And.Q": 0.0
          }
        },
        {
          "inputs": [
            1.0,
            0.0
          ],
          "ticks": 1,
          "expected": {
            "Test And.Q": 0.0
          }
        },
        {
          "inputs": [
            1.0,
            1.0
          ],
          "ticks": 1,
          "expected": {
            "Test And.Q": 1.0
          }
        }
      ]
    },
    {
      "id": "tv02-and-drop-low",
