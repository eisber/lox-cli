    {
      "id": "tv19-temp-sunny-blind-close",
      "description": "Temp > 25 and sunny triggers blind closing",
      "blocks": [
        {
          "type": "GreaterEqual",
          "title": "Temp Hot",
          "connectors": [
            "Input1",
            "Input2",
            "Q"
          ]
        },
        {
          "type": "And",
          "title": "Close Signal",
          "connectors": [
            "I1",
            "I2",
            "Q"
          ]
        },
        {
          "type": "JalousieUpDown2",
          "title": "Blind",
          "connectors": [
            "InputTriggerUp",
            "InputTriggerDown",
            "InputPos",
            "InputDisable",
            "Pos",
            "Dir",
            "Moving",
            "TimeEnd"
          ],
          "params": {
            "TimeEnd": 10.0
          }
        }
      ],
      "wiring": [
        {
          "from": "input:0",
          "to": "Temp Hot.Input1"
        },
        {
          "from": "input:2",
          "to": "Temp Hot.Input2"
        },
        {
          "from": "Temp Hot.Q",
          "to": "Close Signal.I1"
        },
        {
          "from": "input:1",
          "to": "Close Signal.I2"
        },
        {
          "from": "Close Signal.Q",
          "to": "Blind.InputPos"
        }
      ],
      "steps": [
        {
          "inputs": [
            24.0,
            1.0,
            25.0
          ],
          "ticks": 1,
          "expected": {
            "Close Signal.Q": 0.0,
            "Blind.Pos": 0.0
          }
        },
        {
          "inputs": [
            26.0,
            1.0,
            25.0
          ],
          "ticks": 10,
