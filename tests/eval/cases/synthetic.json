[
  {
    "id": "s01-piano-protection",
    "pattern": [
      "threshold",
      "combined-condition"
    ],
    "utterance": "Lower blinds in the living room when it's sunny and above 20 degrees to protect the piano",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "GreaterEqual",
          "title_contains": "20",
          "room": "Wohnzimmer",
          "page": "Wohnzimmer"
        },
        {
          "type": "And",
          "room": "Wohnzimmer",
          "page": "Wohnzimmer"
        }
      ],
      "wiring": [
        {
          "from_title": "Außentemperatur",
          "from_connector": "AQ",
          "to_type": "GreaterEqual",
          "to_connector": "Input1"
        },
        {
          "from_title": "Sonnenschein",
          "from_connector": "AQ",
          "to_type": "And",
          "to_connector": "I1"
        },
        {
          "from_type": "GreaterEqual",
          "from_connector": "Q",
          "to_type": "And",
          "to_connector": "I2"
        },
        {
          "from_type": "And",
          "from_connector": "Q",
          "to_title": "Jalousie 1",
          "to_room": "Wohnzimmer",
          "to_connector": "InputTriggerDown"
        }
      ],
      "params": [
        {
          "block_type": "GreaterEqual",
          "param": "Input2",
          "value": "20"
        }
      ],
      "simulation": [
        {
          "name": "blinds close when hot+sunny",
          "inputs": {
            "Außentemperatur": 25.0,
            "Sonnenschein": 1.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Jalousie 1 [Wohnzimmer].InputTriggerDown": {
              ">": 0.5
            }
          }
        },
        {
          "name": "blinds stay when cold",
          "inputs": {
            "Außentemperatur": 15.0,
            "Sonnenschein": 0.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Jalousie 1 [Wohnzimmer].InputTriggerDown": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
  {
    "id": "s02-night-hallway-dim",
