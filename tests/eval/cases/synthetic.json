      ],
      "params": [
        {
          "block_type": "GreaterEqual",
          "param": "Input2",
          "value": "1320"
        },
        {
          "block_type": "Less",
          "param": "Input2",
          "value": "360"
        },
        {
          "block_type": "Mult",
          "param": "Input2",
          "value": "30"
        }
      ],
      "simulation": [
        {
          "name": "should dim to 30% at midnight (active period)",
          "inputs": {
            "Nachtzeit.minutes_since_midnight": 0.0,
            "Nachtzeit.day_of_week": 0.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lichtsteuerung [Flur].Brightness": {
              ">=": 25,
              "<=": 35
            }
          }
        },
        {
          "name": "should not dim at noon (inactive period)",
          "inputs": {
            "Nachtzeit.minutes_since_midnight": 720.0,
            "Nachtzeit.day_of_week": 0.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lichtsteuerung [Flur].Brightness": {
              "<": 1
            }
          }
        }
      ]
    }
  },
