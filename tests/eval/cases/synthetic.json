          "type": "Or"
        },
        {
          "type": "Mult"
        }
      ],
      "wiring": [
        {
          "from_type": "GreaterEqual",
          "from_connector": "Q",
          "to_type": "Or",
          "to_connector": "I1"
        },
        {
          "from_type": "Less",
          "from_connector": "Q",
          "to_type": "Or",
          "to_connector": "I2"
        },
        {
          "from_type": "Or",
          "from_connector": "Q",
