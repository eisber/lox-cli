[
  {
    "id": "bhe-001-solar-pump-diff",
    "pattern": [
      "solar",
      "pump",
      "threshold",
      "differential"
    ],
    "utterance": "Solar pump: activate when collector temp exceeds storage by 8°C, stop when difference drops below 3°C; wire the pump output to Poolpumpe",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "Solarpumpcontrol",
          "title": "Solar Pump"
        }
      ],
      "wiring": [
        {
          "from_type": "TreeAsensor",
          "from_title": "Collector Temp",
          "from_connector": "AQ",
          "to_type": "Solarpumpcontrol",
          "to_connector": "TCol"
        },
        {
          "from_type": "TreeAsensor",
          "from_title": "Storage Temp",
          "from_connector": "AQ",
          "to_type": "Solarpumpcontrol",
          "to_connector": "AI1"
        }
      ],
      "params": [
        {
          "block_type": "Solarpumpcontrol",
          "param": "DOn",
          "value": "8"
        },
        {
          "block_type": "Solarpumpcontrol",
          "param": "DOf",
          "value": "3"
        }
      ],
      "simulation": [
        {
          "name": "pump activates when collector exceeds storage by 8°C",
          "inputs": {
            "Kesseltemperatur.AQ": 68.0,
            "Puffertemperatur.AQ": 55.0
          },
          "ticks": 30,
          "dt": 0.1,
          "expected_outputs": {
            "Poolpumpe.I1": {
              ">": 0.5
            }
          }
        },
        {
          "name": "pump stays off when difference is small",
          "inputs": {
            "Kesseltemperatur.AQ": 57.0,
            "Puffertemperatur.AQ": 55.0
          },
          "ticks": 30,
          "dt": 0.1,
          "expected_outputs": {
            "Poolpumpe.I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
