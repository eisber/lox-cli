    "id": "bhe-012-central-presence-reset",
    "pattern": [
      "central-presence",
      "reset",
      "occupancy"
    ],
    "utterance": "Set up a central presence controller with 30-minute absence timeout that resets all rooms on departure",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "CentralPresence",
          "title": "Building Presence"
        }
      ],
      "wiring": [],
      "params": [
        {
          "block_type": "CentralPresence",
          "param": "ParamTAbsence",
          "value": "1800"
        }
      ],
      "simulation": [
        {
          "name": "departure triggers reset after timeout",
          "steps": [
            {
              "inputs": {
                "Bewegungsmelder.OutputPresence": 1.0
              },
              "ticks": 5,
              "dt": 10.0
            },
            {
              "inputs": {
                "Bewegungsmelder.OutputPresence": 0.0
              },
              "ticks": 181,
              "dt": 10.0,
              "expected_outputs": {
                "Statusblock.AQ": {
                  ">": 0.0
                }
              }
            }
          ]
        }
      ]
    },
    "hint": "Step-by-step plan (3-block circuit):\n1. lox config add --type Or --title 'Anwesenheit' --room Flur FILE\n2. wire FILE 'Anwesenheit.I1' 'Bewegungsmelder.OutputPresence'\n3. wire FILE 'Anwesenheit.I2' 'Bewegungsmelder Garten.OutputPresence'\n4. lox config add --type OffDelay --title 'Abwesenheit Timer' --room Flur FILE\n5. set-param FILE 'Abwesenheit Timer' Time 1800\n6. wire FILE 'Abwesenheit Timer.InputTrigger' 'Anwesenheit.Q'\n   ⚠ Wire from Or.Q DIRECTLY — do NOT add a Not between Or and OffDelay!\n7. lox config add --type Not --title 'Abgang Signal' --room Flur FILE\n8. wire FILE 'Abgang Signal.I' 'Abwesenheit Timer.Q'\n9. wire FILE 'Statusblock.I' 'Abgang Signal.Q'"
  },
