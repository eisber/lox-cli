[
  {
    "id": "bl01-2point-floor-heating",
    "pattern": [
      "2point",
      "heating",
      "hysteresis"
    ],
    "utterance": "Add a 2-point controller for floor heating in Wohnzimmer: turn on when temperature drops below 19°C, turn off above 21°C; wire the heating output to Heizkörper Bad",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "2Point",
          "title_contains": "Heiz",
          "room": "Wohnzimmer"
        }
      ],
      "wiring": [
        {
          "from_title": "Raumtemperatur Wohnzimmer",
          "from_connector": "AQ",
          "to_type": "2Point",
          "to_connector": "Input"
        }
      ],
      "params": [
        {
          "block_type": "2Point",
          "param": "Target",
          "value": "20"
        },
        {
          "block_type": "2Point",
          "param": "Hysteresis",
          "value": "1"
        }
      ],
      "simulation": [
        {
          "name": "heating on when cold",
          "inputs": {
            "Raumtemperatur Wohnzimmer.AQ": 18.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Heizkörper Bad.I1": {
              ">": 0.5
            }
          }
        },
        {
          "name": "heating off when warm",
          "inputs": {
            "Raumtemperatur Wohnzimmer.AQ": 22.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Heizkörper Bad.I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
