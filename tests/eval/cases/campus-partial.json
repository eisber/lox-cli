            {
              "inputs": {
                "Raumfeuchtigkeit Bad.AQ": 50.0
              },
              "ticks": 20,
              "expected_outputs": {
                "Lichtsteuerung [Bad].I1": {
                  ">": 0.5
                }
              }
            }
          ]
        },
        {
          "name": "fan off when humidity never exceeded threshold",
          "inputs": {
            "Raumfeuchtigkeit Bad.AQ": 50.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lichtsteuerung [Bad].I1": {
              "<": 0.5
            }
          }
        }
      ]
