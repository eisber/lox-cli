          "from_connector": "Q",
          "to_type": "OffDelay",
          "to_connector": "InputTrigger"
        },
        {
          "from_type": "OffDelay",
          "from_connector": "Q",
          "to_title": "Lichtsteuerung [Bad]",
          "to_connector": "I1"
        }
      ],
      "params": [
        {
          "block_type": "OffDelay",
          "param": "Time",
          "value": "300"
        }
      ],
      "simulation": [
        {
          "name": "fan activates when humidity exceeds threshold",
          "inputs": {
            "Raumfeuchtigkeit Bad.AQ": 75.0
          },
          "ticks": 10,
