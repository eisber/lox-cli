  {
    "id": "kx06-add-temp-offset",
    "pattern": [
      "add",
      "analog"
    ],
    "utterance": "Make the outside temperature read 2 degrees higher before the thermostat uses it",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "Add"
        }
      ],
      "wiring": [
        {
          "from_title": "Außentemperatur",
          "to_type": "Add",
          "to_connector": "Input1"
        },
        {
          "from_type": "Add",
          "to_title": "Raumregler",
          "to_connector": "Temp",
          "from_connector": "AQ"
        }
      ],
      "params": [
        {
          "block_type": "Add",
          "param": "Input2",
          "value": "2"
        }
      ],
      "simulation": [
        {
          "inputs": {
            "Außentemperatur.AQ": 20.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Raumregler.TempO": {
              ">=": 21.5,
              "<=": 22.5
            }
          },
          "name": "should trigger when condition met"
        },
        {
          "name": "should NOT trigger when condition not met",
          "inputs": {
            "Außentemperatur.AQ": 10.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Raumregler.TempO": {
              "<": 21.5
            }
          }
        }
      ]
    }
  },
