[
  {
    "id": "kx01-pushbutton-toggle-light",
    "pattern": [
      "pushbutton",
      "toggle"
    ],
    "utterance": "Create a button that turns the living room light on if it is off and off if it is on",
    "difficulty": "easy",
    "expected": {
      "new_blocks": [
        {
          "type": "PushButton"
        }
      ],
      "wiring": [
        {
          "from_type": "PushButton",
          "to_title": "Lichtsteuerung",
          "to_room": "Wohnzimmer",
          "to_connector": "I1",
          "from_connector": "Q"
        }
      ],
      "params": [],
      "simulation": [
        {
          "name": "should activate on button press",
          "inputs": {
            "PushButton.InputTrigger": 1.0,
            "Schalter 1.Q": 1.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lichtsteuerung [Wohnzimmer].I1": {
              ">": 0.5
            }
          }
        },
        {
          "name": "should NOT activate without press",
          "inputs": {
            "PushButton.InputTrigger": 0.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lichtsteuerung [Wohnzimmer].I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
