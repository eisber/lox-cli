  {
    "id": "kx04-offdelay-fan-linger",
    "pattern": [
      "off-delay"
    ],
    "utterance": "Keep the bathroom fan running for 5 minutes after the humidity drops below the threshold",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "GreaterEqual"
        },
        {
          "type": "OffDelay"
        }
      ],
      "wiring": [
        {
          "from_title": "Luftfeuchtigkeit",
          "to_type": "GreaterEqual",
          "to_connector": "Input1"
        },
        {
          "from_type": "GreaterEqual",
          "to_type": "OffDelay",
          "from_connector": "Q",
          "to_connector": "InputTrigger"
        },
        {
          "from_type": "OffDelay",
          "to_title": "Lüfter Bad",
          "to_connector": "I1",
          "from_connector": "Q"
        }
      ],
      "params": [
        {
          "block_type": "GreaterEqual",
          "param": "Input2",
          "value": "70"
        },
        {
          "block_type": "OffDelay",
          "param": "Time",
          "value": "300"
        }
      ],
      "simulation": [
        {
          "name": "humid triggers fan",
          "inputs": {
            "Luftfeuchtigkeit": 80
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lüfter Bad.I1": {
              ">": 0.5
            }
          }
        },
        {
          "name": "dry no fan",
          "inputs": {
            "Luftfeuchtigkeit": 40
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Lüfter Bad.I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
