[
  {
    "id": "no-001-garage-presence-autoclose",
    "pattern": ["garage", "presence", "timer", "auto-close"],
    "utterance": "When the Garagentor Sensor detects the car arriving and the Helligkeit sensor reads below 50 lux (it's dark), open the Garagentor. After 5 minutes with no further trigger, auto-close it via a Monoflop timer.",
    "difficulty": "hard",
    "expected": {
      "new_blocks": [
        { "type": "Less" },
        { "type": "And" },
        { "type": "Monoflop" },
        { "type": "EdgeDetection" }
      ],
      "wiring": [
        {
          "from_title": "Helligkeit",
          "from_connector": "AQ",
          "to_type": "Less",
          "to_connector": "Input1"
        },
        {
          "from_title": "Garagentor Sensor",
          "from_connector": "Q",
          "to_type": "And",
          "to_connector": "I1"
        },
        {
          "from_type": "Less",
          "from_connector": "Q",
          "to_type": "And",
          "to_connector": "I2"
        },
        {
          "from_type": "And",
          "from_connector": "Q",
          "to_title": "Garagentor",
          "to_connector": "I1"
        },
        {
          "from_type": "And",
          "from_connector": "Q",
          "to_type": "Monoflop",
          "to_connector": "InputTrigger"
        },
        {
          "from_type": "Monoflop",
          "from_connector": "Q",
          "to_type": "EdgeDetection",
          "to_connector": "Input"
        },
        {
          "from_type": "EdgeDetection",
          "from_connector": "FallingEdge",
          "to_title": "Garagentor",
          "to_connector": "I1"
        }
      ],
      "params": [
        { "block_type": "Less", "param": "Input2", "value": "50" },
        { "block_type": "Monoflop", "param": "Time", "value": "300" }
      ],
      "simulation": [
        {
          "name": "should open garage when car detected in dark",
          "inputs": {
            "Garagentor Sensor.Q": 1.0,
            "Helligkeit.AQ": 20.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Garagentor.I1": { ">": 0.5 }
          }
        },
        {
          "name": "should NOT open garage when bright outside",
          "inputs": {
            "Garagentor Sensor.Q": 1.0,
            "Helligkeit.AQ": 200.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Garagentor.I1": { "<": 0.5 }
          }
        },
        {
          "name": "should auto-close after timer expires (falling edge)",
          "steps": [
            {
              "inputs": {
                "Garagentor Sensor.Q": 1.0,
                "Helligkeit.AQ": 20.0
              },
              "ticks": 5,
              "dt": 0.1
            },
            {
              "inputs": {
                "Garagentor Sensor.Q": 0.0,
                "Helligkeit.AQ": 20.0
              },
              "ticks": 5,
              "dt": 60.0,
              "expected_outputs": {
                "Garagentor.I1": { ">": 0.5 }
              }
            }
          ]
        }
      ]
    }
  },
