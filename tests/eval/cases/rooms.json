[
  {
    "id": "kr01-bedroom-auto-shade",
    "pattern": [
      "auto-shading",
      "threshold"
    ],
    "utterance": "Set up automatic shading in the bedroom: when sunshine is strong and temperature is above 22°C, lower both blinds automatically",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "GreaterEqual"
        },
        {
          "type": "And"
        }
      ],
      "wiring": [
        {
          "from_title": "Sonnenschein",
          "to_type": "And",
          "to_connector": "I1"
        },
        {
          "from_title": "Außentemperatur",
          "to_type": "GreaterEqual",
          "to_connector": "Input1"
        },
        {
          "from_type": "GreaterEqual",
          "to_type": "And",
          "from_connector": "Q",
          "to_connector": "I2"
        },
        {
          "from_type": "And",
          "to_title": "Jalousie 1",
          "to_room": "Schlafzimmer",
          "to_connector": "InputTriggerDown",
          "from_connector": "Q"
        },
        {
          "from_type": "And",
          "to_title": "Jalousie 2",
          "to_room": "Schlafzimmer",
          "to_connector": "InputTriggerDown",
          "from_connector": "Q"
        }
      ],
      "params": [
        {
          "block_type": "GreaterEqual",
          "param": "Input2",
          "value": "22"
        }
      ],
      "simulation": [
        {
          "name": "should trigger when condition met",
          "inputs": {
            "Sonnenschein.AQ": 1.0,
            "Außentemperatur.AQ": 27.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Jalousie 1 [Schlafzimmer].InputTriggerDown": {
              ">": 0.5
            }
          }
        },
        {
          "name": "should NOT trigger when condition not met",
          "inputs": {
            "Sonnenschein.AQ": 0.0,
            "Außentemperatur.AQ": 17.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Jalousie 1 [Schlafzimmer].InputTriggerDown": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
