  {
    "id": "k001-threshold",
    "pattern": [
      "threshold"
    ],
    "utterance": "close Jalousie 1 in Wohnzimmer when temperature exceeds 30°C",
    "difficulty": "easy",
    "expected": {
      "new_blocks": [
        {
          "type": "GreaterEqual"
        }
      ],
      "wiring": [
        {
          "from_title": "Außentemperatur",
          "to_type": "GreaterEqual",
          "to_connector": "Input1",
          "from_connector": "AQ"
        },
        {
          "from_type": "GreaterEqual",
          "to_title": "Jalousie 1",
          "to_room": "Wohnzimmer",
          "to_connector": "InputTriggerDown",
          "from_connector": "Q"
        }
      ],
      "params": [
        {
          "block_type": "GreaterEqual",
          "param": "Input2",
          "value": "30"
        }
      ],
      "simulation": [
        {
          "name": "should trigger when condition met",
          "inputs": {
            "Außentemperatur.AQ": 35.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Jalousie 1 [Wohnzimmer].InputTriggerDown": {
              ">": 0.5
            }
          }
        },
        {
          "name": "should NOT trigger when condition not met",
          "inputs": {
            "Außentemperatur.AQ": 25.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Jalousie 1 [Wohnzimmer].InputTriggerDown": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
