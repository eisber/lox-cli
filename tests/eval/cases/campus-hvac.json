[
  {
    "id": "ch-001",
    "pattern": [
      "heating-mode-setpoints",
      "analog-multiplexer",
      "setpoint-switch"
    ],
    "utterance": "Set up comfort/eco setpoint switching for the Wohnzimmer: use an AnalogMultiplexer to select 22°C when the room is occupied and 18°C when empty, and wire the output to the Raumregler setpoint input; wire the setpoint output to Raumregler.Input",
    "difficulty": "medium",
    "source": "campus-wiring-graph: heating-mode-setpoints pattern — AnalogMultiplexer selects setpoint based on occupancy",
    "expected": {
      "new_blocks": [
        {
          "type": "AnalogMultiplexer2",
          "title": "Set Setpoint"
        }
      ],
      "wiring": [
        {
          "from_type": "AnalogMultiplexer2",
          "from_connector": "AQ",
          "to_title": "Raumregler",
          "to_room": "Wohnzimmer",
          "to_connector": "SetpointOverride"
        }
      ],
      "params": [
        {
          "block_type": "AnalogMultiplexer2",
          "param": "Input1",
          "value": "18"
        },
        {
          "block_type": "AnalogMultiplexer2",
          "param": "Input2",
          "value": "22"
        }
      ],
      "simulation": [
        {
          "name": "occupied room gets comfort setpoint 22",
          "inputs": {
            "Set Setpoint.Select": 1.0
          },
          "ticks": 5,
          "dt": 0.1,
          "expected_outputs": {
            "Raumregler.Input": {
              "==": 22.0
            }
          }
        },
        {
          "name": "empty room gets eco setpoint 18",
          "inputs": {
            "Set Setpoint.Select": 0.0
          },
          "ticks": 5,
          "dt": 0.1,
          "expected_outputs": {
            "Raumregler.Input": {
              "==": 18.0
            }
          }
        }
      ]
    }
  },
  {
