  {
    "id": "ch-004",
    "pattern": [
      "window-heating-inhibit",
      "and-gate",
      "memory"
    ],
    "utterance": "Combine the Wohnzimmer window and door contacts into a single heating inhibit signal: wire both Fensterkontakt Wohnzimmer and Türkontakt Wohnzimmer through an Or gate, then into a Memory block to latch the 'window open' state, and connect Memory.Q to Raumregler.Window; wire the combined window signal to Raumregler.Window",
    "difficulty": "hard",
    "source": "campus-wiring-graph: window-heating-inhibit — And:Fenster offen + Memory:Außentüre Offen",
    "expected": {
      "new_blocks": [
        {
          "type": "Or",
          "title": "Fenster offen"
        },
        {
          "type": "Memory",
          "title": "Window State"
        }
      ],
      "wiring": [
        {
          "from_title": "Fensterkontakt Wohnzimmer",
          "from_connector": "AQ",
          "to_type": "Or",
          "to_connector": "I1"
        },
        {
          "from_title": "Türkontakt Wohnzimmer",
          "from_connector": "AQ",
          "to_type": "Or",
          "to_connector": "I2"
        },
        {
          "from_type": "Or",
          "from_connector": "Q",
          "to_type": "Memory",
          "to_connector": "Input"
        },
        {
          "from_type": "Memory",
          "from_connector": "Q",
          "to_title": "Raumregler",
          "to_room": "Wohnzimmer",
          "to_connector": "Window"
        }
      ],
      "params": [],
      "simulation": [
        {
          "name": "window open latches inhibit",
          "steps": [
            {
              "inputs": {
                "Fensterkontakt Wohnzimmer.AQ": 0.0,
                "Türkontakt Wohnzimmer.AQ": 0.0
              },
              "ticks": 2,
              "dt": 0.1
            },
            {
              "inputs": {
                "Fensterkontakt Wohnzimmer.AQ": 1.0,
                "Türkontakt Wohnzimmer.AQ": 0.0
              },
              "ticks": 5,
              "dt": 0.1,
              "expected_outputs": {
                "Window State.Q": {
                  ">": 0.5
                }
              }
            }
          ]
        },
        {
          "name": "door open also latches inhibit",
          "steps": [
            {
              "inputs": {
                "Fensterkontakt Wohnzimmer.AQ": 0.0,
                "Türkontakt Wohnzimmer.AQ": 0.0
              },
              "ticks": 2,
              "dt": 0.1
            },
            {
              "inputs": {
                "Fensterkontakt Wohnzimmer.AQ": 0.0,
                "Türkontakt Wohnzimmer.AQ": 1.0
              },
              "ticks": 5,
              "dt": 0.1,
              "expected_outputs": {
                "Window State.Q": {
                  ">": 0.5
                }
              }
            }
          ]
        },
        {
          "name": "no inhibit when both closed",
          "inputs": {
            "Fensterkontakt Wohnzimmer.AQ": 0.0,
            "Türkontakt Wohnzimmer.AQ": 0.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Raumregler.Window": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
