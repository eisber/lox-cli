  {
    "id": "tg01-bedroom-temp-memory",
    "pattern": [
      "memory",
      "math",
      "night-mode"
    ],
    "utterance": "Remember the current bedroom temperature when I press the switch, then subtract 3 degrees as the night setpoint; wire the stored temperature to the Statusblock",
    "difficulty": "hard",
    "expected": {
      "new_blocks": [
        {
          "type": "AMemory",
          "title_contains": "Temp",
          "room": "Schlafzimmer",
          "page": "Schlafzimmer"
        },
        {
          "type": "Sub",
          "title_contains": "Night",
          "room": "Schlafzimmer",
          "page": "Schlafzimmer"
        }
      ],
      "wiring": [
        {
          "from_title": "Raumtemperatur Schlafzimmer",
          "from_connector": "AQ",
          "to_type": "AMemory",
          "to_connector": "Input"
        },
        {
          "from_title": "Schalter 1",
          "from_connector": "Q",
          "to_type": "AMemory",
          "to_connector": "Trigger"
        },
        {
          "from_type": "AMemory",
          "from_connector": "AQ",
          "to_type": "Sub",
          "to_connector": "Input1"
        }
      ],
      "params": [
        {
          "block_type": "Sub",
          "param": "Input2",
          "value": "3"
        }
      ],
      "simulation": [
        {
          "name": "memory stores temp",
          "inputs": {
            "Raumtemperatur Schlafzimmer": 20,
            "Schalter 1.Q": 1
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Statusblock.I1": {
              ">": 10
            }
          }
        },
        {
          "name": "no trigger no store",
          "inputs": {
            "Raumtemperatur Schlafzimmer": 20
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Statusblock.I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
