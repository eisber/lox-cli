[
  {
    "id": "ua01-smart-alarm-arm-trigger",
    "pattern": [
      "alarm",
      "pre-alarm",
      "timer"
    ],
    "utterance": "Smart alarm: arm via button, trigger with 30s pre-alarm, then full alarm after timeout; wire the alarm output to Alarmanlage",
    "difficulty": "hard",
    "expected": {
      "new_blocks": [
        {
          "type": "AalSmartAlarm"
        }
      ],
      "wiring": [
        {
          "from_title": "Taster Arm",
          "to_type": "AalSmartAlarm",
          "to_connector": "Leave"
        },
        {
          "from_title": "Bewegungsmelder Flur",
          "to_type": "AalSmartAlarm",
          "to_connector": "Movement Throughfare"
        },
        {
          "from_type": "AalSmartAlarm",
          "to_title": "Sirene",
          "from_connector": "Alarm Level 2",
          "to_connector": "I1"
        }
      ],
      "params": [
        {
          "block_type": "AalSmartAlarm",
          "param": "Time Throughfare Alarm",
          "value": "30"
        },
        {
          "block_type": "AalSmartAlarm",
          "param": "Delay Alarm Level 2",
          "value": "30"
        }
      ],
      "simulation": [
        {
          "name": "should raise alarm level 2 after trigger during armed state",
          "inputs": {
            "Schalter 1.Q": 1.0,
            "Bewegungsmelder.OutputPresence": 1.0
          },
          "ticks": 50,
          "dt": 0.1,
          "expected_outputs": {
            "Alarmanlage.I1": {
              ">": 0.5
            }
          }
        },
        {
          "name": "should NOT alarm when not armed",
          "inputs": {
            "Schalter 1.Q": 0.0,
            "Bewegungsmelder.OutputPresence": 1.0
          },
          "ticks": 50,
          "dt": 0.1,
          "expected_outputs": {
            "Alarmanlage.I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
