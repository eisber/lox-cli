[
  {
    "id": "ch-001",
    "pattern": [
      "checkout-sequence",
      "nfc-checkout"
    ],
    "utterance": "When a guest checks out by removing their NFC card from the reader, turn off all lights in the Schlafzimmer, pause audio, and reset the heating to eco mode",
    "difficulty": "hard",
    "expected": {
      "new_blocks": [
        {
          "type": "Memory"
        },
        {
          "type": "EdgeDetection"
        },
        {
          "type": "OnPulseDelay"
        }
      ],
      "wiring": [
        {
          "from_title": "Türkontakt Schlafzimmer",
          "to_type": "EdgeDetection",
          "to_connector": "Input",
          "from_connector": "AQ"
        },
        {
          "from_type": "EdgeDetection",
          "to_type": "Memory",
          "to_connector": "Input",
          "from_connector": "FallingEdge"
        },
        {
          "from_type": "Memory",
          "to_type": "OnPulseDelay",
          "to_connector": "InputTrigger",
          "from_connector": "Q"
        },
        {
          "from_type": "OnPulseDelay",
          "to_title": "Lichtsteuerung",
          "to_room": "Schlafzimmer",
          "to_connector": "Reset",
          "from_connector": "Q"
        }
      ],
      "params": [],
      "simulation": [
        {
          "name": "should reset lights on card removal (falling edge)",
          "steps": [
            {
              "inputs": {
                "Gäste NFC.Q1": 1.0
              },
              "ticks": 3,
              "dt": 0.1
            },
            {
              "inputs": {
                "Gäste NFC.Q1": 0.0
              },
              "ticks": 5,
              "dt": 0.1,
              "expected_outputs": {
                "Lichtsteuerung [Schlafzimmer].Reset": {
                  ">": 0.5
                }
              }
            }
          ]
        },
        {
          "name": "should NOT reset lights while card is inserted",
          "steps": [
            {
              "inputs": {
                "Gäste NFC.Q1": 0.0
              },
              "ticks": 2,
              "dt": 0.1
            },
            {
              "inputs": {
                "Gäste NFC.Q1": 1.0
              },
              "ticks": 5,
              "dt": 0.1,
              "expected_outputs": {
                "Lichtsteuerung [Schlafzimmer].Reset": {
                  "<": 0.5
                }
              }
            }
          ]
        }
      ]
    }
  },
