[
  {
    "id": "ns01-freezer-temp-alarm",
    "pattern": [
      "monitoring",
      "threshold",
      "timer",
      "analog-watchdog"
    ],
    "utterance": "Monitor the freezer temperature sensor (Raumtemperatur Küche) — if it rises above -15°C for more than 10 minutes continuously, trigger a notification via a virtual output alarm block; wire the delayed alarm output to Alarmanlage",
    "difficulty": "hard",
    "expected": {
      "new_blocks": [
        {
          "type": "GreaterEqual",
          "title_contains": "Freezer",
          "room": "Küche"
        },
        {
          "type": "OnDelay",
          "room": "Küche"
        },
        {
          "type": "VirtualOut",
          "title_contains": "Alarm"
        }
      ],
      "wiring": [
        {
          "from_title": "Raumtemperatur Küche",
          "from_connector": "AQ",
          "to_type": "GreaterEqual",
          "to_connector": "Input1"
        },
        {
          "from_type": "GreaterEqual",
          "from_connector": "Q",
          "to_type": "OnDelay",
          "to_connector": "InputTrigger"
        },
        {
          "from_type": "OnDelay",
          "from_connector": "Q",
          "to_type": "VirtualOut",
          "to_connector": "I"
        }
      ],
      "params": [
        {
          "block_type": "GreaterEqual",
          "param": "Input2",
          "value": "-15"
        },
        {
          "block_type": "OnDelay",
          "param": "Time",
          "value": "600"
        }
      ],
      "simulation": [
        {
          "name": "temp above threshold triggers alarm after delay",
          "inputs": {
            "Raumtemperatur Küche.AQ": -10.0
          },
          "ticks": 6500,
          "dt": 0.1,
          "expected_outputs": {
            "Alarmanlage.I": {
              ">": 0.5
            }
          }
        },
        {
          "name": "temp below threshold no alarm",
          "inputs": {
            "Raumtemperatur Küche.AQ": -20.0
          },
          "ticks": 6500,
          "dt": 0.1,
          "expected_outputs": {
            "Alarmanlage.I": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
