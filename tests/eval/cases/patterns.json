  {
    "id": "kp03-verzoegerter-tueroeffner",
    "pattern": [
      "door-access",
      "monoflop"
    ],
    "utterance": "Wenn die Türklingel klingelt, öffne die Tür nach 1 Sekunde für 3 Sekunden",
    "difficulty": "hard",
    "expected": {
      "new_blocks": [
        {
          "type": "OnPulseDelay"
        },
        {
          "type": "Monoflop"
        }
      ],
      "wiring": [
        {
          "from_title": "Türklingel",
          "from_connector": "Q",
          "to_type": "OnPulseDelay",
          "to_connector": "InputTrigger"
        },
        {
          "from_type": "OnPulseDelay",
          "to_type": "Monoflop",
          "to_connector": "InputTrigger",
          "from_connector": "Q"
        },
        {
          "from_type": "Monoflop",
          "from_connector": "Q",
          "to_title": "Türöffner",
          "to_connector": "I1"
        }
      ],
      "params": [
        {
          "block_type": "OnPulseDelay",
          "param": "Time",
          "value": "1"
        },
        {
          "block_type": "Monoflop",
          "param": "Time",
          "value": "3"
        }
      ],
      "simulation": [
        {
          "name": "door opens after delay (test at t=2s during pulse)",
          "inputs": {
            "Türklingel.Q": 1.0
          },
          "ticks": 20,
          "dt": 0.1,
          "expected_outputs": {
            "Türöffner [Flur].I1": {
              ">": 0.5
            }
          }
        },
        {
          "name": "door stays closed without trigger",
          "inputs": {},
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Türöffner [Flur].I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
