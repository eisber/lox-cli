[
  {
    "id": "kp01-doorbell-unlock",
    "pattern": [
      "door-access",
      "monoflop"
    ],
    "utterance": "When the doorbell rings, unlock the front door for 3 seconds",
    "difficulty": "medium",
    "expected": {
      "new_blocks": [
        {
          "type": "Monoflop"
        }
      ],
      "wiring": [
        {
          "from_title": "Türklingel",
          "from_connector": "Q",
          "to_type": "Monoflop",
          "to_connector": "InputTrigger"
        },
        {
          "from_type": "Monoflop",
          "from_connector": "Q",
          "to_title": "Türöffner",
          "to_connector": "I1"
        }
      ],
      "params": [
        {
          "block_type": "Monoflop",
          "param": "Time",
          "value": "3"
        }
      ],
      "simulation": [
        {
          "inputs": {
            "Türklingel.Q": 1.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Türöffner.I1": {
              ">": 0.5
            }
          },
          "name": "should trigger when condition met"
        },
        {
          "name": "should NOT trigger when condition not met",
          "inputs": {
            "Türklingel.Q": 0.0
          },
          "ticks": 10,
          "dt": 0.1,
          "expected_outputs": {
            "Türöffner.I1": {
              "<": 0.5
            }
          }
        }
      ]
    }
  },
