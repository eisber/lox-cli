{
    "version": "2.0",
    "fixture": "fixture.Loxone",
    "metrics": {
        "block_precision": "correct_blocks / total_blocks_added (penalizes extra blocks)",
        "block_recall": "correct_blocks / expected_blocks (penalizes missing blocks)",
        "wiring_accuracy": "correct_wires / expected_wires",
        "param_accuracy": "correct_params / expected_params",
        "overall_score": "(0.20 * block_f1) + (0.30 * wiring_accuracy) + (0.20 * param_accuracy) + (0.15 * check_score) + (0.15 * trace_score)",
        "pass_threshold": 0.8,
        "difficulty_weights": {
            "easy": 1.0,
            "medium": 1.5,
            "hard": 2.0,
            "expert": 3.0
        },
        "wiring_precision": "correct_new_wires / total_new_wires (penalizes extra wires)",
        "ux_score": "blocks_with_page_and_position / total_new_blocks",
        "xml_valid": "result parses as valid XML",
        "validation_pass": "lox config validate returns 0 errors",
        "cli_invocations": "number of lox CLI commands executed",
        "retries": "number of failed attempts before success",
        "token_estimate": "estimated input+output tokens (chars/4)",
        "trace_score": "BFS reachability through wiring graph: reachable_paths / expected_wiring_count",
        "simulation_score": "lox-sim signal evaluation: assertion_passes / total_assertions (optional, only when simulation spec exists)",
        "check_score": "lox config check pass rate: ok_checks / total_checks"
    },
